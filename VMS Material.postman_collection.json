	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"if (pm.collectionVariables.get('accessToken')) {",
					"    pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + pm.collectionVariables.get('accessToken') });",
					"}"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"if (pm.response.code === 403) {",
					"    const originalRequest = pm.request.clone();",
					"    pm.sendRequest({",
					"        url: pm.collectionVariables.get('baseUrl').replace('/material','') + '/user/refresh-token',",
					"        method: 'POST',",
					"        header: { 'Authorization': 'Bearer ' + pm.collectionVariables.get('accessToken') }",
					"    }, function (err, res) {",
					"        if (!err && res.code === 200 && res.json().accessToken) {",
					"            pm.collectionVariables.set('accessToken', res.json().accessToken);",
					"            // Retry the original request with new token",
					"            originalRequest.headers.upsert({ key: 'Authorization', value: 'Bearer ' + res.json().accessToken });",
					"            pm.sendRequest(originalRequest, function (err2, res2) {",
					"                // Optionally, you can log or process res2 here",
					"            });",
					"        } else {",
					"            pm.collectionVariables.set('accessToken', '');",
					"            console.log('Refresh failed. Please re-login.');",
					"        }",
					"    });",
					"}"
				]
			}
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "https://localhost:3001/api/material"
		},
		{
			"key": "accessToken",
			"value": ""
		},
		{
			"key": "url",
			"value": "https://localhost:3001",
			"type": "string"
		}
	]
