{
  "info": {
    "_postman_id": "3f02600d-d749-4902-93d5-afd024aa860f",
    "name": "VMS Material",
    "description": "All Material endpoints for VMS.\n\n**Usage Instructions:**\n- Set the `baseUrl` variable to your API base (default: http://localhost:3001/api/material).\n- Set the `accessToken` variable after login.\n- All requests will use the Authorization header automatically.\n- If a request returns 403, the collection will auto-refresh the token and retry the request.\n- The refresh endpoint is POST {{baseUrl}}/../user/refresh-token with Authorization: Bearer <expired_token>.\n- If refresh fails, re-login to get a new accessToken.\n",
    "schema": "https://schema.getpostman.com/json/collection/v2.0.0/collection.json",
    "_exporter_id": "40065133"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 && pm.response.json().accessToken) {",
                  "    pm.collectionVariables.set('accessToken', pm.response.json().accessToken);",
                  "    console.log('accessToken set!');",
                  "} else {",
                  "    console.log('Login failed or accessToken not found in response.');",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"ADMIN\",\n  \"password\": \"ADMIN\"\n}"
            },
            "url": "{{url}}/user/login",
            "description": "Login to obtain accessToken. Replace with your credentials."
          },
          "response": []
        }
      ]
    },
